package dao;
import java.sql.Connection;
import java.sql.PreparedStatement;
import java.sql.ResultSet;
import java.sql.SQLException;
import dbconnection.DbConnection;
import stdbms.student.Student;
//Data access object+> It is a design pattern to seperate
// your business logic/blue  print from database logic.
public class StudentDao {
// method for displaying students
	public void displayStudent()  throws SQLException{
		Connection c = DbConnection.getConnection();
		String query = "SELECT * FROM student";
		 PreparedStatement ps = c.prepareStatement(query);
	 ResultSet rs =	ps.executeQuery();
	 while(rs.next()) {
		 System.out.println(
				 rs.getInt("id") + " | " +
		         rs.getString("name") + " | " + 
				 rs.getString("course")
				 );
		 }
		 rs.close();
		 ps.close();
		 c.close();
		// statement :- used for static queries :- select * from emp;
		// preparedStatement extends statement :- Dynamic queries:-- DML = insert,update,delete
		// CallableStatement extends preparedStatement :- stored procedures
	 }	
	public void insert(Student s) throws SQLException {
	Connection	c = DbConnection.getConnection();
	String query = "insert into student values(?,?,?)";
	PreparedStatement ps = c.prepareStatement(query);
	ps.setInt(1,s.getId());
	ps.setString(2,s.getName());
	ps.setString(3, s.getCourse());
int rows =	ps.executeUpdate();
System.out.println(rows + " record updated");
ps.close();
c.close();
	}
	//method for updating details
	public void updateStudent(Student s) throws SQLException{
		Connection c = DbConnection.getConnection();
		String query = 
				"update student set name = ?,course = ? where id = ?";
		PreparedStatement ps = c.prepareStatement(query);
		ps.setString(1,s.getName());
		ps.setString(2,s.getCourse());
		ps.setInt(3, s.getId());
	int rows =	ps.executeUpdate();
	System.out.println(rows + " record updated");
	ps.close();
	c.close();
	}
	// method for deleting
	public void deleteStudent(int id) throws SQLException {
		Connection c = DbConnection.getConnection();
		String query = "delete from student where id =?";
		PreparedStatement ps = c.prepareStatement(query);
			ps.setInt(1, id);
			int rows = ps.executeUpdate();
			System.out.println(rows + " record updated");
			ps.close();
			c.close();
	}
}
